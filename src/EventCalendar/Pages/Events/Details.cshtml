@page "/events/{id:long}"
@model EventCalendar.Pages.Events.DetailsModel
@{
    ViewData["Title"] = Model.Event.Name;
}
<section class="page-heading"><p class="eyebrow">@Model.Template.Name · @Model.Event.Format</p><h1>@Model.Event.Name</h1><p>@Model.Event.StartLocal.ToString("dddd, MMMM d · h:mm tt")–@Model.Event.EndLocal.ToString("h:mm tt")</p></section>
<div class="detail-grid">
    <section class="panel facts">
        <div><small>Location</small><strong>@Model.Event.Location</strong></div>
        <div><small>Players</small><strong>@Model.Event.RegistrationCount / @Model.Event.Capacity</strong><span>@Model.Event.SeatsRemaining seats remaining · @Model.Event.MinimumPlayers minimum</span></div>
        <div><small>Duration</small><strong>@(Model.Event.DurationMinutes / 60.0) hours</strong></div>
        <a asp-page-handler="Calendar" asp-route-id="@Model.Event.Id" class="button secondary">Download calendar invite</a>
    </section>
    <section class="panel qr-panel">
        <h2>@(Model.Event.IsFull ? "Event full" : "Register to play")</h2>
        @if (Model.Event.IsFull){<p>All @Model.Event.Capacity seats are taken.</p>}
        else {<div class="qr">@Html.Raw(Model.QrSvg)</div><p>Scan the code or share this registration link.</p><a href="@Model.RegistrationUrl">@Model.RegistrationUrl</a>}
    </section>
</div>
